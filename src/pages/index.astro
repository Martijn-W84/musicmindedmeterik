---
import BaseLayout from "../layouts/BaseLayout.astro";
import Artists from "../components/Artists.astro";
---

<BaseLayout>
  <main class="flex flex-col items-center gap-20">
    <section class="max-w-3xl">
      <p>Meterik is een dorp met vele muzikale gezichten.</p>
      <p>
        Deze site probeert een overzicht te geven van diverse muziekprojecten
        met een link naar Meterik.
      </p>
      <p>
        Mocht je nog aanvullende informatie hebben, over een genoemde artiest of
        iemand die er nog niet op staat, stuur dan je informatie op via de 
        <a href="/contact" class="text-teal-600"> contact </a> pagina.
      </p>
    </section>
    <section>
      <Artists />
    </section>
  </main>
</BaseLayout>
