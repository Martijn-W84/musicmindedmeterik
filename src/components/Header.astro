---
import { SITE_TITLE } from "../consts";
const currentPath = Astro.url.pathname;
import Logo from "../assets/logo.svg";
---

<header class="md:flex md:items-center">
  <nav class="fixed w-full z-20 top-0 inset-s-0 bg-white shadow-md">
    <div class="min-h-3 bg-linear-to-r from-teal-500 to-sky-600 text-white">
    </div>
    <div
      class="max-w-7xl flex flex-wrap items-center justify-between mx-auto p-4"
    >
      <a href="/" id="title" class="text-xl md:text-3xl font-bold flex gap-4 items-center">
          <Logo width={48} height={48} />
          {SITE_TITLE}
      </a>

      <!-- Mobile toggle -->
      <button
        id="menuButton"
        aria-label="Menu button"
        data-collapse-toggle="navbar-dropdown"
        class="inline-flex items-center p-2 w-10 h-10 md:hidden"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24">
          <path
            stroke="currentColor"
            stroke-width="2"
            d="M5 7h14M5 12h14M5 17h14"></path>
        </svg>
      </button>

      <!-- Menu -->
      <div class="hidden w-full md:block md:w-auto" id="navbar-dropdown">
        <ul
          id="nav-list"
          class="relative flex flex-col md:flex-row md:space-x-8 p-4 md:p-0 mt-4 md:mt-0"
        >
          <!-- indicator -->
          <span id="nav-indicator"></span>
          <li>
            <a
              href="/carnaval"
              class={`nav-link ${currentPath.startsWith("/carnaval") ? "active" : ""}`}
            >
              Carnaval
            </a>
          </li>

          <li>
            <a
              href="/contact"
              class={`nav-link ${currentPath === "/contact" ? "active" : ""}`}
            >
              Contact
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  #title {
    font-family: var(--font-abeezee);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  /* ACTIVE LINK */
  .active {
    font-weight: 600;
    color: oklch(70.4% 0.14 182.503);
  }

  /* INDICATOR (pill style) */
  #nav-indicator {
    position: absolute;
    height: 4px;
    background-color: #00bba7;
    background-image: linear-gradient(to right, #00bba7, #0084d1);
    border-radius: 9999px;

    transition:
      left 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.25s ease;

    width: 0;
    left: 0;
    top: 0;
    opacity: 0;
  }

  /* rotate arrow */
  .rotate svg {
    transform: rotate(180deg);
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indicator = document.getElementById("nav-indicator");
    const navLinks = document.querySelectorAll(".nav-link");
    const nav = document.getElementById("nav-list");

    let hasInitialized = false;

    function moveIndicator(el: any) {
      const rect = el.getBoundingClientRect();
      const parentRect = nav!.getBoundingClientRect();
      const isMobile = window.innerWidth < 768;

      const paddingX = 12; // matches px-3 (0.75rem)

      const width = rect.width - paddingX * 2;
      const leftBase = rect.left - parentRect.left + paddingX;

      if (isMobile) {
        indicator!.style.width = width + "px";
        indicator!.style.left = leftBase + "px";
        indicator!.style.top =
          rect.top - parentRect.top + rect.height - 4 + "px";
      } else {
        indicator!.style.width = width + "px";
        indicator!.style.left = leftBase + "px";
        indicator!.style.top = rect.bottom - parentRect.top - 4 + "px";
      }

      if (!hasInitialized) {
        indicator!.style.transition = "none";
        indicator!.style.opacity = "1";

        requestAnimationFrame(() => {
          indicator!.style.transition = "";
          hasInitialized = true;
        });
      }
    }

    // hover
    navLinks.forEach((link) => {
      link.addEventListener("mouseenter", () => moveIndicator(link));
    });

    // active on load
    let active = document.querySelector(".nav-link.active");
    if (active) moveIndicator(active);

    // reset
    nav!.addEventListener("mouseleave", () => {
      if (active) moveIndicator(active);
    });

    // resize
    window.addEventListener("resize", () => {
      active = document.querySelector(".nav-link.active");
      if (active) moveIndicator(active);
    });

    // mobile toggle
    const mobileToggleBtn = document.querySelector(
      '[data-collapse-toggle="navbar-dropdown"]',
    );
    const mobileMenu = document.getElementById("navbar-dropdown");

    mobileToggleBtn?.addEventListener("click", () => {
      mobileMenu!.classList.toggle("hidden");

      setTimeout(() => {
        const active = document.querySelector(".nav-link.active");
        if (active) moveIndicator(active);
      }, 50);
    });
  });
</script>
