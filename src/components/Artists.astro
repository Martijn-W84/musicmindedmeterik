---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const { category } = Astro.props;

const allArtists = await getCollection("artists");

const artists = allArtists
  .filter((artist) => {
    // If prop is false/undefined, show all artists automatically
    if (category != "carnaval") return true; 
    
    // If prop is true, only return artists whose categories include "carnaval"
    // (Converts categories to lowercase to prevent matching errors)
    return artist.data.category.toLowerCase().includes("carnaval");
  })
  .sort((a, b) => {
    const nameA = a.data.name.toUpperCase();
    const nameB = b.data.name.toUpperCase();
    if (nameA < nameB) return -1;
    if (nameA > nameB) return 1;
    return 0;
  });

const serializedArtists = artists.map((artist) => ({
  name: artist.data.name,
  description: artist.data.description,
  category: artist.data.category,
  slug: artist.id,
}));
---

<div class="flex flex-col items-center w-full max-w-6xl mx-auto">
  <input
    placeholder="Zoeken naar artiesten..."
    class="border p-2 mb-6 rounded bg-white w-full md:w-md max-w-md"
    type="text"
    id="search_input"
  />
  <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 item-list">
    {
      artists.map((artist) => (
        <li>
          <a
            href={`/artists/${artist.id}/`}
            class="flex flex-col gap-4 h-full justify-between rounded p-4 shadow-sm hover:shadow-md transition-shadow"
          >
            {artist.data.heroImage && (
              <Image
                width={720}
                height={360}
                priority
                src={artist.data.heroImage}
                alt=""
                layout="full-width"
                class="object-cover"
              />
            )}
            <div class="flex flex-col justify-between">
              <h1 class="text-2xl font-bold">{artist.data.name}</h1>
              <p>{artist.data.category}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
  <div id="no_results_message" class="text-gray-500 mt-8" hidden>
    Geen artiesten gevonden voor "<span
      id="search_term_placeholder"
      class="font-semibold"></span>".
  </div>
</div>

<script define:vars={{ serializedArtists }}>
  document.addEventListener("astro:page-load", () => {
    const searchInput = document.getElementById("search_input");
    const resultItems = document.querySelectorAll(".item-list > li");
    // 2. Selecteer de nieuwe HTML-elementen
    const noResultsMessage = document.getElementById("no_results_message");
    const searchTermPlaceholder = document.getElementById(
      "search_term_placeholder",
    );

    searchInput?.addEventListener("input", (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();
      let visibleCount = 0; // Houder om te tellen hoeveel items zichtbaar blijven

      serializedArtists.forEach((artist, index) => {
        const matchesName = artist.name?.toLowerCase().includes(searchTerm);
        const matchesDescription = artist.description
          ?.toLowerCase()
          .includes(searchTerm);
        const matchesCategory = artist.category
          ?.toLowerCase()
          .includes(searchTerm);

        if (
          matchesName ||
          matchesDescription ||
          matchesCategory ||
          searchTerm === ""
        ) {
          resultItems[index].removeAttribute("hidden");
          visibleCount++; // Item is zichtbaar, dus verhoog de teller
        } else {
          resultItems[index].setAttribute("hidden", true);
        }
      });

      // 3. Toon of verberg de fallback op basis van de teller
      if (visibleCount === 0 && searchTerm !== "") {
        if (searchTermPlaceholder)
          searchTermPlaceholder.textContent = e.target.value;
        noResultsMessage?.removeAttribute("hidden");
      } else {
        noResultsMessage?.setAttribute("hidden", true);
      }
    });
  });
</script>